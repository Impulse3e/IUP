# Скопируйте в .env и заполните

# === Telegram (опционально, legacy) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Сервер ===
# Оставьте change-me-in-production — при старте ключ запишется в data/secret.key
# Для доступа с другого компьютера в сети:
# 1) сервер: --host 0.0.0.0
# 2) в IUP Student включите «Показать адрес сервера» → http://IP-сервера:8000
# 3) CORS для LAN подхватывается автоматически (192.168/10/172.16-31)
# Дополнительно можно явно прописать origin:
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.1.10:8000
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./data/iup.db
IUP_SERVER_URL=http://localhost:8000
IUP_SESSION_TOKEN=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_BYTES=20971520
RETENTION_DAYS=90

# === Storage ===
STORAGE_BACKEND=local
STORAGE_PATH=./data/storage
S3_ENDPOINT=
S3_BUCKET=iup-evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=

# === Seed admin (создаётся при старте сервера, если пользователя ещё нет) ===
SEED_ADMIN_EMAIL=admin@iup.local
SEED_ADMIN_PASSWORD=admin123

# Полный набор демо-аккаунтов: scripts/seed_demo.py
#   admin@iup.local    / admin123
#   teacher@iup.local  / teacher123
#   proctor@iup.local  / proctor123
#   student@iup.local  / student123

# === Agent ===
IUP_HEARTBEAT_INTERVAL=5
IUP_CHUNK_INTERVAL=30
IUP_EVIDENCE_SECONDS=10
IUP_IDENTITY_THRESHOLD=0.32

# === Proctor thresholds ===
PROCTOR_YAW_THRESHOLD=38
PROCTOR_PITCH_THRESHOLD=55
PROCTOR_ROLL_THRESHOLD=22
PROCTOR_CONFIRM_FRAMES=24
PROCTOR_FOCUS_CONFIRM_FRAMES=36
PROCTOR_IDENTITY_CONFIRM_FRAMES=8
PROCTOR_ALERT_COOLDOWN=45
PROCTOR_REMINDER_INTERVAL=120
PROCTOR_AUDIO_QUIET_RMS=0
PROCTOR_AUDIO_LOUD_RMS=480
PROCTOR_AUDIO_SUSTAIN_SEC=4
PROCTOR_AUDIO_CHECK_INTERVAL=0.5

# === LTI stub (выключен, пока не заданы оба значения) ===
LTI_CLIENT_ID=
LTI_DEPLOYMENT_ID=
LTI_LAUNCH_SECRET=
